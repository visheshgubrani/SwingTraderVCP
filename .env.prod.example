# --- Compose / images ---
GHCR_IMAGE_PREFIX=ghcr.io/visheshgubrani/swingtradervcp
IMAGE_TAG=latest
API_HOST_PORT=8002
CLIENT_HOST_PORT=8090
SWYINGIFY_HOST_PORT=3002

# --- Postgres (on VPS) ---
POSTGRES_USER=algo
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=algo_trading

# --- Redis (Compose internal network — no host port) ---
# Do not set REDIS_URL. Compose sets REDIS_HOST=redis and the app builds the URL.
REDIS_PASSWORD=replace-with-strong-redis-password

# --- FastAPI ---
APP_ENVIRONMENT=production
APP_PASSWORD=replace-with-strong-workstation-password
SQL_ECHO=false
ENABLE_DOCS_IN_PRODUCTION=false
CORS_ORIGINS=["https://app.edurel.xyz"]
FRONTEND_PUBLIC_URL=https://app.edurel.xyz
FYERS_APP_ID=
FYERS_SECRET_KEY=
# 4-digit Fyers trading PIN, used by the headless TOTP login (verify_pin_v2).
FYERS_PIN=
# Fyers fy_id (e.g. XV12345). Blank derives it from FYERS_APP_ID.
FYERS_USER_ID=
# Base32 secret from Fyers MyAccount -> External 2FA / TOTP.
FYERS_TOTP_KEY=
# Fyers retires every access token at this IST time daily (broker-confirmed),
# regardless of the expires_in it reports.
FYERS_SESSION_CUTOFF_IST=06:30
# Dedicated pgcrypto key for broker_auth_tokens. Required. Do not reuse FYERS_SECRET_KEY.
# If existing ciphertext was encrypted with FYERS_SECRET_KEY, set this to that value
# for the first boot, complete a Fyers re-login, then rotate to a new dedicated key.
TOKEN_ENCRYPTION_KEY=replace-with-high-entropy-token-encryption-key
# Must match the Fyers app redirect URI exactly (personal client callback).
# The Telegram one-tap link reuses this same registered URI.
FYERS_REDIRECT_URI=https://app.edurel.xyz/callback
# Writable dir for fyers-apiv3 SDK file logs inside the container.
FYERS_LOG_PATH=/tmp

# --- Daily broker-auth guard (Fyers tokens now die at 06:30 IST daily) -------
# SEBI's April-2026 retail-algo framework removed continuous refresh-token
# sessions, so the guard verifies the session on these IST slots, retries the
# headless TOTP login, and pushes a one-tap login link to Telegram when the
# session is still missing.
AUTH_GUARD_ENABLED=true
AUTH_GUARD_HOURS=[7,8]
AUTH_GUARD_MINUTES=[0,15,30,45]
AUTH_GUARD_MAX_HEADLESS_ATTEMPTS=3
# Opt-in headless login: needs FYERS_USER_ID + FYERS_PIN + FYERS_TOTP_KEY.
AUTH_HEADLESS_LOGIN_ENABLED=false
AUTH_MAGIC_LINK_TTL_MINUTES=60
AUTH_MAGIC_LINK_MAX_USES=5
AUTH_NOTIFY_SUCCESS=true
AUTH_NOTIFY_COOLDOWN_MINUTES=30
# Telegram (send-only, free). See DEPLOY.md for the BotFather steps.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public base URL of the API, used to build the one-tap login link.
API_PUBLIC_BASE_URL=https://api.edurel.xyz

EXECUTION_MODE=paper
LIVE_ORDER_PLACEMENT_ENABLED=false
PAPER_INITIAL_CAPITAL=500000
# Also requires the durable P10 rollout stage to be explicitly set to `paper`.
PAPER_AUTO_ARM_PROPOSALS=true
SAAS_INTERNAL_API_KEY=replace-with-shared-random-secret
# OpenRouter API key for VCP proposal inference (P10 vision LLM). Without it
# every proposal candidate fails closed and no proposal batch is produced.
OPENROUTER_API_KEY=
# Auto-enqueue the P10 proposal batch after each EOD personal scan, so
# unattended paper (or live) execution has proposals for the next session.
PROPOSAL_AUTOMATION_ENABLED=true
PROPOSAL_QUEUE_NAME=arq:queue:p10-proposals
PROPOSAL_BATCH_BUDGET_MINUTES=45
# Locked production top-20 shortlist.
PROPOSAL_BATCH_LIMIT=20
PROPOSAL_ATTEMPT_TIMEOUT_SECONDS=90
PROPOSAL_MAX_ATTEMPTS=2
NSE_TRADING_HOLIDAYS=[]

# Optional P7 (leave off for Step 1)
P7_FUNDAMENTAL_PASS_ENABLED=false

# --- Swyingify (Step 2 — fill when enabling --profile saas) ---
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
# NEXT_PUBLIC_BETTER_AUTH_URL=
# API_URL=http://api:8000
# SITE_URL=
# SEO_INDEXING_ENABLED=false
# SWYINGIFY_ADMIN_EMAILS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
