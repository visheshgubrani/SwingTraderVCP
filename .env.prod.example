# --- Compose / images ---
GHCR_IMAGE_PREFIX=ghcr.io/visheshgubrani/swingtradervcp
IMAGE_TAG=latest
API_HOST_PORT=8002
CLIENT_HOST_PORT=8090
SWYINGIFY_HOST_PORT=3002

# --- Postgres (on VPS) ---
POSTGRES_USER=algo
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=algo_trading

# --- Redis (Compose internal network — no host port) ---
# Do not set REDIS_URL. Compose sets REDIS_HOST=redis and the app builds the URL.
REDIS_PASSWORD=replace-with-strong-redis-password

# --- FastAPI ---
APP_ENVIRONMENT=production
APP_PASSWORD=replace-with-strong-workstation-password
SQL_ECHO=false
ENABLE_DOCS_IN_PRODUCTION=false
CORS_ORIGINS=["https://app.edurel.xyz"]
FRONTEND_PUBLIC_URL=https://app.edurel.xyz
FYERS_APP_ID=
FYERS_SECRET_KEY=
# Dedicated pgcrypto key for broker_auth_tokens. Required. Do not reuse FYERS_SECRET_KEY.
# If existing ciphertext was encrypted with FYERS_SECRET_KEY, set this to that value
# for the first boot, complete a Fyers re-login, then rotate to a new dedicated key.
TOKEN_ENCRYPTION_KEY=replace-with-high-entropy-token-encryption-key
# Must match the Fyers app redirect URI exactly (personal client callback).
FYERS_REDIRECT_URI=https://app.edurel.xyz/callback
# Writable dir for fyers-apiv3 SDK file logs inside the container.
FYERS_LOG_PATH=/tmp
EXECUTION_MODE=paper
LIVE_ORDER_PLACEMENT_ENABLED=false
PAPER_INITIAL_CAPITAL=500000
# Also requires the durable P10 rollout stage to be explicitly set to `paper`.
PAPER_AUTO_ARM_PROPOSALS=true
SAAS_INTERNAL_API_KEY=replace-with-shared-random-secret
PROPOSAL_AUTOMATION_ENABLED=false
PROPOSAL_QUEUE_NAME=arq:queue:p10-proposals
PROPOSAL_BATCH_BUDGET_MINUTES=45
# Testing default is 10. Restore locked production top-20 with 20.
PROPOSAL_BATCH_LIMIT=10
PROPOSAL_ATTEMPT_TIMEOUT_SECONDS=90
PROPOSAL_MAX_ATTEMPTS=2
NSE_TRADING_HOLIDAYS=[]

# Optional P7 (leave off for Step 1)
P7_FUNDAMENTAL_PASS_ENABLED=false

# --- Swyingify (Step 2 — fill when enabling --profile saas) ---
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
# NEXT_PUBLIC_BETTER_AUTH_URL=
# API_URL=http://api:8000
# SITE_URL=
# SEO_INDEXING_ENABLED=false
# SWYINGIFY_ADMIN_EMAILS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
