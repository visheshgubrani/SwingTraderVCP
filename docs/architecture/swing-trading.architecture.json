  "cards": [
    {
      "dot": "cyan",
      "title": "Startup",
      "items": [
        "Compose starts Postgres, Redis, FastAPI, then the workers",
        "Core arq pulls Fyers EOD candles, then runs the scan, P7, and P9 into Postgres",
        "A weekday Telegram reminder fires when the Fyers session is not healthy"
      ]
    },
    {
      "dot": "emerald",
      "title": "Research to plan",
      "items": [
        "P7 reads Upstox, then asks OpenRouter for a blind second opinion",
        "The proposal queue sends the top 20 to a concurrency-1 worker",
        "Gemini audits the chart; Python writes the immutable plan to Postgres"
      ]
    },
    {
      "dot": "amber",
      "title": "Entries and exits",
      "items": [
        "Live entry waits for an unexpired human approval of that exact plan",
        "Tick ingestion publishes LTP and 5m bars; entry and the monitor read Redis",
        "Execution engine is the only Fyers order REST caller, for entries and exits"
      ]
    },
    {
      "dot": "rose",
      "title": "Boundaries",
      "items": [
        "Tick ingestion alone holds the Fyers market WebSocket",
        "Order gateway alone holds the order WebSocket and writes fills to Postgres",
        "Kill switch blocks new automated orders; the Swyingify scan never places them"
      ]
    }
  ]
