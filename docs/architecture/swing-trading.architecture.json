      },
      {
        "id": "exits",
        "label": "Exits and fills",
        "focus": ["ticks", "redis", "monitor", "gateway", "fyers", "postgres"],
        "note": "Position monitor exits from Redis LTP. Order gateway persists Fyers fills and never decides when to trade."
      },
      {
        "id": "workers",
        "label": "Worker processes",
        "focus": ["redis", "core", "proposal", "ticks", "entry", "monitor", "gateway"],
        "note": "Redis fans out jobs and live data. Tick ingestion owns the market socket. Order gateway owns the order socket."
