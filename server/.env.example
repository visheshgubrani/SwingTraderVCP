# Local / container FastAPI settings (copy to server/.env — never commit secrets).

APP_ENVIRONMENT=development
APP_PASSWORD=dev_swing_password_2026
DATABASE_URL=postgresql+asyncpg://algo:algo@localhost:5480/algo_trading
REDIS_URL=redis://localhost:6380/0

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_PUBLIC_URL=http://localhost:5173

FYERS_APP_ID=
FYERS_SECRET_KEY=
# Dedicated pgcrypto key for broker tokens. Required in production.
# Local/dev may omit this and fall back to FYERS_SECRET_KEY.
TOKEN_ENCRYPTION_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:5173/callback
# Writable dir for fyers-apiv3 SDK logs (required in Docker; /app is not writable).
FYERS_LOG_PATH=/tmp

EXECUTION_MODE=paper
LIVE_ORDER_PLACEMENT_ENABLED=false
# Paper P10 seed in INR. Keep this aligned with risk_policies.deployable_capital_override (₹1,00,000).
PAPER_INITIAL_CAPITAL=100000

# Shared with Swyingify Next BFF for paid SaaS history HMAC assertions.
SAAS_INTERNAL_API_KEY=

EOD_SYNC_ENABLED=true
SAAS_STANDARD_SCAN_FALLBACK_ENABLED=true
PERSONAL_SCAN_RUNNING_STALE_SECONDS=3600
TOKEN_REFRESH_ENABLED=true
RECONCILIATION_ENABLED=true
P7_FUNDAMENTAL_PASS_ENABLED=false
NSE_FUNDAMENTAL_RISK_ENABLED=true
NSE_CORPORATE_FILINGS_BASE_URL=https://www.nseindia.com

# On-demand VCP vision validator (advisory chart-image second opinion).
# Requires OPENROUTER_API_KEY to be set in server/.env.
VCP_VISION_ENABLED=false
VCP_VISION_MODEL=google/gemini-3.7-flash
VCP_VISION_REASONING_EFFORT=medium  # low | medium | high | xhigh
VCP_VISION_MAX_TOKENS=16384  # includes hidden reasoning + structured JSON

# P10 remains off for shadow rollout until explicitly enabled. The proposal
# worker still runs so expiry/recovery supervision is available.
PROPOSAL_AUTOMATION_ENABLED=false
PROPOSAL_QUEUE_NAME=arq:queue:p10-proposals
PROPOSAL_BATCH_BUDGET_MINUTES=45
PROPOSAL_ATTEMPT_TIMEOUT_SECONDS=90
PROPOSAL_MAX_ATTEMPTS=2
# Keep this maintained from the official NSE calendar before live use.
NSE_TRADING_HOLIDAYS=[]
