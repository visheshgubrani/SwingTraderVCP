# Local / container FastAPI settings (copy to server/.env — never commit secrets).

APP_ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://algo:algo@localhost:5480/algo_trading
REDIS_URL=redis://localhost:6380/0

# Production / Upstash example (TLS + password required):
# REDIS_URL=rediss://default:TOKEN@xxxx.upstash.io:6379

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_PUBLIC_URL=http://localhost:5173

FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:5173/callback
# Writable dir for fyers-apiv3 SDK logs (required in Docker; /app is not writable).
FYERS_LOG_PATH=/tmp

EXECUTION_MODE=paper
LIVE_ORDER_PLACEMENT_ENABLED=false

# Shared with Swyingify Next BFF for paid SaaS history HMAC assertions.
SAAS_INTERNAL_API_KEY=

EOD_SYNC_ENABLED=true
SAAS_STANDARD_SCAN_FALLBACK_ENABLED=true
PERSONAL_SCAN_RUNNING_STALE_SECONDS=3600
TOKEN_REFRESH_ENABLED=true
RECONCILIATION_ENABLED=true
P7_FUNDAMENTAL_PASS_ENABLED=false
