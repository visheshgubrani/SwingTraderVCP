DATABASE_URL=postgresql://algo:algo@localhost:5480/algo_trading
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
API_URL=http://localhost:8000
# HMAC signing key shared only by Next and the private FastAPI service.
SAAS_INTERNAL_API_KEY=replace-with-a-shared-random-secret

# Optional bootstrap/admin test accounts. Server-only, comma-separated.
SWYINGIFY_ADMIN_EMAILS=

# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SEO/canonical controls.
SITE_URL=http://localhost:3000
SEO_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
